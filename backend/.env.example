# Diverge Backend Configuration
# Copy to .env and customize

# AWS Configuration
DIVERGE_AWS_REGION=us-east-1

# Bedrock Models (change to test different models)
DIVERGE_DEBATE_MODEL_ID=us.amazon.nova-pro-v1:0
DIVERGE_METRICS_MODEL_ID=us.amazon.nova-lite-v1:0

# Model Parameters
DIVERGE_DEBATE_TEMPERATURE=0.75
DIVERGE_DEBATE_MAX_TOKENS=1024
DIVERGE_METRICS_TEMPERATURE=0.0

# DynamoDB Tables
DIVERGE_DEBATES_TABLE=diverge-debates
DIVERGE_USERS_TABLE=diverge-users

# Cognito (from SAM template outputs after deploy)
DIVERGE_COGNITO_USER_POOL_ID=
DIVERGE_COGNITO_CLIENT_ID=

# CORS (JSON array format — pydantic-settings parses this automatically)
DIVERGE_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
DIVERGE_MAX_DEBATES_PER_HOUR=5

# Debug
DIVERGE_DEBUG=true
