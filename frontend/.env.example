# Diverge Frontend Configuration

# Backend API URL (FastAPI on Lambda Function URL or localhost)
VITE_API_URL=http://localhost:8000

# Cognito Auth (from SAM template outputs after deploy)
# Leave empty for local dev without auth
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_URI=http://localhost:5173
