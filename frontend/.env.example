# Diverge Frontend Configuration
#
# Local frontend + local backend:
#   VITE_API_URL=http://localhost:8000
#   VITE_DEBATE_URL=
#   VITE_CHECKPOINTED_DEBATE=true
#
# Local frontend + live AWS backend:
#   VITE_API_URL=https://8bkyvvrp4j.execute-api.us-east-1.amazonaws.com/prod
#   VITE_DEBATE_URL=https://nj4y3i5l3ezxlr2cu2k2lemcn40qghrk.lambda-url.us-east-1.on.aws
#   VITE_CHECKPOINTED_DEBATE=true

# Backend API URL (FastAPI on API Gateway or localhost)
VITE_API_URL=http://localhost:8000
VITE_DEBATE_URL=
VITE_CHECKPOINTED_DEBATE=true

# Cognito Auth (from SAM template outputs after deploy)
# Leave empty for local dev without auth
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_URI=http://localhost:5173
